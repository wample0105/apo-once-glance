{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onceglance",
  "version": "0.1.1",
  "identifier": "com.wample.onceglance",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "定影 Onceglance",
        "url": "index.html",
        "width": 900,
        "height": 640,
        "minWidth": 680,
        "minHeight": 520,
        "decorations": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=9700"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/assets/logo/**",
          "**/Pictures/**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../assets/logo/*",
      "../assets/logo/png/*",
      "binaries/once.exe"
    ]
  }
}